{
  "_comment": "설정 폴더(AJOU_CONFIG_DIR)에 autopilot.json으로 두면 기본 규칙 대신 쓴다. 단계: 0 알림, 1 캘린더, 2 준비, 3 초안. level은 그 단계까지 올리고 max는 그 단계로 자른다. 맞는 규칙 중 가장 높은 level을 가장 낮은 max로 자른다. when의 값이 목록이면 그중 하나, 참·거짓이면 그대로 맞아야 한다. 공지 사실: source(notice), board, category, relevance, eligibility, has_deadline, has_events, has_asks. 메일 사실: source(mail), kind, importance, has_events, has_action, trusted(학교 발신). shadow를 true로 하면 2·3단계를 카드에 적기만 하고 진행하지 않는다.",
  "daily_limit": 3,
  "quiet_hours": [
    23,
    8
  ],
  "shadow": false,
  "rules": [
    {
      "name": "관련 높은 공지의 일정",
      "when": {
        "source": "notice",
        "relevance": [
          "high"
        ],
        "eligibility": [
          "likely",
          "unknown"
        ]
      },
      "level": 1
    },
    {
      "name": "자격이 확실한 보통 공지의 마감",
      "when": {
        "source": "notice",
        "relevance": [
          "medium"
        ],
        "eligibility": [
          "likely"
        ]
      },
      "level": 1
    },
    {
      "name": "학교 메일의 날짜가 정해진 일",
      "when": {
        "source": "mail",
        "trusted": true,
        "has_events": true
      },
      "level": 1
    },
    {
      "name": "남에게 부탁할 서류가 있는 공지",
      "when": {
        "source": "notice",
        "relevance": [
          "high",
          "medium"
        ],
        "eligibility": [
          "likely",
          "unknown"
        ],
        "has_asks": true
      },
      "level": 2
    },
    {
      "name": "교수·교직원 메일의 할 일",
      "when": {
        "source": "mail",
        "trusted": true,
        "kind": [
          "교수·교직원"
        ],
        "has_action": true
      },
      "level": 2
    },
    {
      "name": "자격 되는 장학·국제·활동",
      "when": {
        "source": "notice",
        "category": [
          "scholarship",
          "international",
          "activity"
        ],
        "relevance": [
          "high"
        ],
        "eligibility": [
          "likely"
        ]
      },
      "level": 3
    },
    {
      "name": "채용 공고는 캘린더까지",
      "when": {
        "board": [
          "recruit"
        ]
      },
      "max": 1
    }
  ]
}
